# ArtFlow backend — variables d'environnement (copier vers .env)
# NE JAMAIS committer un .env réel.

# Django
SECRET_KEY=change-me-in-production
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (docker compose infrastructure/docker-compose.yml)
DATABASE_URL=postgresql://artflow:artflow_dev@127.0.0.1:5435/artflow

# DRF throttling
ANON_THROTTLE_RATE=200/min
